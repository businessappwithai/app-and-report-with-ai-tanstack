%% ============================================================================
%% EML Example — Analytics & Reporting
%%
%% The reporting platform's own domain, modelled in EML: data sources, saved
%% queries, the report / chart / dashboard definitions built on them, and the
%% scheduled jobs that deliver them.
%%
%% Written for the `enterprise-reporting` target:
%%
%%   bun language/cli/eml.ts generate -i examples/analytics-reporting.eml.mmd \
%%     -o ./out --stack enterprise-reporting
%%
%% That target compiles the ERD — tables, Zod schemas, forms, columns — and
%% emits the rules below as GoRules JDM without wiring them up. It does not
%% compile the workflow section or %%rbac. Both are written anyway: the same
%% file generates a whole application under --stack tanstack-nestjs, and the
%% checker validates all of it either way.
%% ============================================================================

%% ---- Section 1: ERD (structure) -------------------------------------------
%%meta name: Analytics Reporting
%%meta kind: erd
%%meta version: 1.0.0
%%meta description: A reporting workspace: connected data sources, the queries saved against them, and the reports, charts, dashboards and scheduled deliveries built on those queries.

%%enum ClientType: pg, mysql, mssql
%%enum SourceStatus: draft, testing, connected, unreachable, retired
%%enum QueryStatus: draft, published, deprecated
%%enum ChartType: bar, line, area, pie, scatter, table
%%enum ExportFormat: csv, xlsx, pdf
%%enum JobStatus: scheduled, queued, running, succeeded, failed, cancelled

%%category name: Sources; description: The databases this workspace can query, and what the platform knows about the tables inside them; icon: Database; color: #0ea5e9; entities: DataSource
%%category name: Analysis; description: The saved questions, and the reports and charts built on them; icon: LineChart; color: #6366f1; entities: SavedQuery, ReportDefinition, ChartDefinition
%%category name: Delivery; description: Dashboards people read, and the schedules that send reports to those who do not open the platform; icon: Send; color: #ec4899; entities: Dashboard, ScheduledJob
%%category name: People; description: The workspace itself and the analysts who work in it; icon: Users; color: #22c55e; entities: Workspace, Analyst

erDiagram
    Workspace {
        string   id PK
        string   name UK
        string   slug UK
        text     description OPTIONAL
        boolean  is_active
    }

    Analyst {
        string   id PK
        string   workspace_id FK
        string   email UK
        string   display_name
        string   job_title OPTIONAL
        boolean  is_active
        datetime last_seen_at OPTIONAL
    }

    DataSource {
        string   id PK
        string   workspace_id FK
        string   name UK
        text     description OPTIONAL
        string   client_type
        string   host
        integer  port
        string   database_name
        string   status
        boolean  is_readonly
        datetime last_checked_at OPTIONAL
    }

    SchemaEntity {
        string   id PK
        string   data_source_id FK
        string   table_name
        string   display_name OPTIONAL
        text     instructions OPTIONAL
        integer  column_count
        boolean  is_indexed
    }

    SavedQuery {
        string   id PK
        string   data_source_id FK
        string   author_id FK
        string   name
        text     sql_text
        text     description OPTIONAL
        string   status
        integer  row_limit
        datetime last_run_at OPTIONAL
    }

    ReportDefinition {
        string   id PK
        string   saved_query_id FK
        string   owner_id FK
        string   name
        text     description OPTIONAL
        string   filename_template OPTIONAL
        boolean  is_public
        integer  page_size
    }

    ChartDefinition {
        string   id PK
        string   saved_query_id FK
        string   owner_id FK
        string   name
        string   chart_type
        string   x_field
        string   y_field
        integer  refresh_interval_seconds OPTIONAL
        boolean  is_public
    }

    Dashboard {
        string   id PK
        string   workspace_id FK
        string   owner_id FK
        string   name
        text     description OPTIONAL
        boolean  is_public
        integer  column_count
    }

    DashboardWidget {
        string   id PK
        string   dashboard_id FK
        string   report_definition_id FK OPTIONAL
        string   chart_definition_id FK OPTIONAL
        string   title
        integer  grid_x
        integer  grid_y
        integer  grid_width
        integer  grid_height
    }

    ScheduledJob {
        string   id PK
        string   report_id FK
        string   requested_by_id FK
        string   name
        string   schedule_cron
        string   export_format
        string   recipients
        boolean  is_active
    }

    JobExecution {
        string   id PK
        string   scheduled_job_id FK
        string   status
        datetime started_at OPTIONAL
        datetime finished_at OPTIONAL
        integer  row_count OPTIONAL
        text     error_message OPTIONAL
    }

    Workspace  ||--o{ Analyst          : "employs"
    Workspace  ||--o{ DataSource       : "connects"
    Workspace  ||--o{ Dashboard        : "publishes"
    DataSource ||--o{ SchemaEntity     : "exposes"
    DataSource ||--o{ SavedQuery       : "answers"
    Analyst    ||--o{ SavedQuery       : "writes"
    SavedQuery ||--o{ ReportDefinition : "feeds"
    SavedQuery ||--o{ ChartDefinition  : "feeds"
    Analyst    ||--o{ ReportDefinition : "owns"
    Analyst    ||--o{ ChartDefinition  : "owns"
    Analyst    ||--o{ Dashboard        : "owns"
    Dashboard  ||--o{ DashboardWidget  : "arranges"
    ReportDefinition ||--o{ DashboardWidget : "is shown in"
    ChartDefinition  ||--o{ DashboardWidget : "is shown in"
    ReportDefinition ||--o{ ScheduledJob : "is delivered by"
    Analyst    ||--o{ ScheduledJob     : "requests"
    ScheduledJob ||--o{ JobExecution   : "records"

    %%field DataSource.client_type enum: ClientType
    %%field DataSource.status enum: SourceStatus
    %%field SavedQuery.status enum: QueryStatus
    %%field ChartDefinition.chart_type enum: ChartType
    %%field ScheduledJob.export_format enum: ExportFormat
    %%field JobExecution.status enum: JobStatus

    %%field DataSource.is_readonly help: Whether the platform may only read. A source that is not read-only is one an analyst's query can change, which is why every connection defaults to true.
    %%field SavedQuery.row_limit help: The LIMIT applied at the source database. Pagination happens there, never in the browser — these are other people's production databases.
    %%field SchemaEntity.instructions help: Written by a person, in prose, saying what this table actually means. It is fed to the model as context, and it is the single highest-leverage thing anyone can fill in for natural-language query quality.
    %%field ReportDefinition.is_public help: Whether the report is served on an unauthenticated share link. A publication decision, not a convenience flag.
    %%field ChartDefinition.refresh_interval_seconds help: How often a rendered chart re-runs its query. Empty means it runs once when opened.

    %%entity DataSource help: An external database this workspace can query. Its credentials are stored encrypted and never shown again after they are entered.
    %%entity SavedQuery help: One SQL statement, named and kept, against one data source. Reports and charts are built on saved queries rather than on ad-hoc SQL so that the same question is asked the same way every time.
    %%entity ScheduledJob help: A standing instruction to run a report on a schedule and deliver the result. Every run is recorded as a JobExecution, successes included.

    %%entity Workspace help: A tenant of the reporting platform — one organisation's data sources, queries and dashboards, kept apart from every other's. It is the outermost boundary in the system: nothing in one workspace can reference anything in another, which is what makes the platform safe to share.
    %%field Workspace.name help: The organisation as its own people refer to it. It appears in the header of every screen and in the subject line of every scheduled delivery.
    %%field Workspace.slug help: The short, URL-safe form the workspace is addressed by. It cannot change once links have been shared, because a renamed slug breaks every dashboard URL anybody has bookmarked.
    %%field Workspace.description help: What this workspace is for, for the benefit of somebody who has just been given access to it and does not yet know what they are looking at.
    %%field Workspace.is_active help: Whether the workspace may still be used. Clearing it stops sign-in and scheduled deliveries while leaving every definition intact, which is what a suspension needs to be.

    %%entity Analyst help: Somebody who can ask questions of this workspace's data. An analyst is scoped to one workspace and owns the queries, reports and dashboards they create — which is why deactivating one has to leave their work behind rather than delete it.
    %%field Analyst.workspace_id help: The workspace this analyst belongs to. It is the whole of their access: an analyst cannot see a data source, query or dashboard outside it.
    %%field Analyst.email help: The address the analyst signs in with and where scheduled deliveries addressed to them arrive. It identifies the person, so changing it changes who the account belongs to.
    %%field Analyst.display_name help: The name shown as the author of a query and the owner of a dashboard. It is what a colleague sees when they want to ask who built something.
    %%field Analyst.job_title help: What the analyst does, which is the quickest way for a reader to judge how much weight to give a query they did not write.
    %%field Analyst.is_active help: Whether the analyst may still sign in. Their queries, reports and dashboards keep running — a deactivated author does not stop a scheduled delivery, which is deliberate and worth knowing.
    %%field Analyst.last_seen_at help: When the analyst last used the platform. It is what an access review is conducted on: an account unused for months is the one to question.

    %%field DataSource.workspace_id help: The workspace this connection belongs to. A data source is never shared between workspaces, which is the boundary the whole tenancy model rests on.
    %%field DataSource.name help: What this connection is called when an analyst picks it from a list. Name it for the business system it points at, not for the server it runs on.
    %%field DataSource.description help: What lives in this database and what it is good for answering. It is the note that stops an analyst querying the wrong system, and the only place that knowledge is written down.
    %%field DataSource.client_type help: pg, mysql or mssql — which driver the platform connects with. It also decides which SQL dialect a saved query has to be written in, so a query is not portable between sources of different types.
    %%field DataSource.host help: The hostname or address the database answers on. Reachable from the platform rather than from the analyst's own machine, which is the usual reason a connection test fails.
    %%field DataSource.port help: The port the database listens on. Held explicitly rather than defaulted, because a non-standard port is common and a wrong one looks exactly like a firewall problem.
    %%field DataSource.database_name help: The database to connect to on that server. One data source is one database: a server holding three of them is three data sources.
    %%field DataSource.status help: draft — not yet tested; testing — a connection attempt is in progress; connected — last check succeeded; unreachable — last check failed; retired — deliberately taken out of use. Only a connected source can be queried.
    %%field DataSource.is_readonly help: Whether the credentials are read-only. They should be: a reporting platform has no business writing to a production database, and this flag is the record that somebody checked.
    %%field DataSource.last_checked_at help: When the connection was last verified. A `connected` status from three weeks ago is not evidence the source is reachable now, which is what this date is for.

    %%entity SchemaEntity parent: DataSource
    %%entity SchemaEntity help: One table in a connected data source, as the platform understands it. The catalogue is what the natural-language pipeline reads to turn a question into SQL, so a table missing from it is a table nobody can ask about — and the instructions on it are how a business teaches the platform its own vocabulary.
    %%field SchemaEntity.data_source_id help: The connection this table was found in. Read inside the data source, where the catalogue together is what the platform knows about it.
    %%field SchemaEntity.table_name help: The table's real name in the database, exactly as SQL must spell it. Discovered by introspection rather than typed, so a mismatch here means the catalogue is stale.
    %%field SchemaEntity.display_name help: What people call this table when they are talking about the business rather than the schema — `Invoices` for `fin_inv_hdr`. It is what appears in a question's answer.
    %%field SchemaEntity.instructions help: What the natural-language pipeline needs to know to use this table correctly: which column is the date anyone means, which rows are test data, what a status code stands for. This is the single most valuable text in the catalogue and the one nobody fills in.
    %%field SchemaEntity.column_count help: How many columns the table has, from introspection. A quick signal of how much of a table a question is likely to be reaching into.
    %%field SchemaEntity.is_indexed help: Whether this table has been added to the retrieval index the question pipeline searches. An unindexed table is invisible to natural-language questions even though it is catalogued.

    %%field SavedQuery.data_source_id help: The connection this statement runs against. It also fixes the dialect the SQL has to be written in, so a query cannot be repointed at a source of a different type.
    %%field SavedQuery.author_id help: The analyst who wrote it. It is who a colleague asks when the result looks wrong, and it stays attributed after they leave.
    %%field SavedQuery.name help: The question this query answers, phrased as a question if that reads better. `Monthly revenue by region` tells a reader what they will get; `Query 14` does not.
    %%field SavedQuery.sql_text help: The statement itself. It is read-only at run time and must be a SELECT or a WITH — a reporting query that writes is refused, which is the platform's main structural safeguard.
    %%field SavedQuery.description help: What the query means, what it excludes, and what it must not be used for. A query that silently filters out cancelled orders is right for one question and badly wrong for another, and this is the only place that is said.
    %%field SavedQuery.status help: draft — being worked on; published — safe for others to build on; deprecated — kept because reports still reference it, but not to be used again. Publishing is a promise to colleagues, not a save.
    %%field SavedQuery.row_limit help: The most rows a run may return. It protects the source database and the platform alike — an unbounded query against a fact table is the single easiest way to take both down.
    %%field SavedQuery.last_run_at help: When the query last executed. A published query nothing has run for months is usually one whose underlying table has changed shape.

    %%entity ReportDefinition help: A saved query presented as a document — named, laid out, and exportable. The report is what somebody outside the analytics team actually receives, which is why it is a definition of its own rather than a view of the query.
    %%field ReportDefinition.saved_query_id help: The query that supplies the rows. Changing the query changes every delivery of this report, which is why queries are published rather than edited in place.
    %%field ReportDefinition.owner_id help: The analyst answerable for the report. It is who is contacted when a recipient disputes a figure.
    %%field ReportDefinition.name help: The report's title as recipients see it, on screen and in the exported file. Write it for somebody who did not ask for it.
    %%field ReportDefinition.description help: What the report shows and what it deliberately leaves out. Recipients read this before the numbers, and it is what stops a figure being quoted out of context.
    %%field ReportDefinition.filename_template help: The pattern the exported file is named by, so a recipient receiving one every week can tell them apart and file them. A template without a date in it produces a folder of indistinguishable attachments.
    %%field ReportDefinition.is_public help: Whether everybody in the workspace may open it, as opposed to only the owner. Public is the default worth choosing deliberately: a report nobody can find is a report nobody uses.
    %%field ReportDefinition.page_size help: Rows per page when the report is read on screen or paginated into a document. It is a readability setting, not a limit on what the query returns.

    %%entity ChartDefinition help: A saved query drawn rather than tabulated. A chart is its own definition because the choice of axes is an interpretation of the data: the same query plotted two ways answers two different questions, and both are worth keeping.
    %%field ChartDefinition.saved_query_id help: The query supplying the points. Its columns are what the axes below have to name, so a query whose columns are renamed breaks every chart built on it.
    %%field ChartDefinition.owner_id help: The analyst answerable for the chart, and who is asked when a reader thinks it is misleading.
    %%field ChartDefinition.name help: The chart's title, as it appears above the drawing and on any dashboard carrying it. Say what the chart shows, not what kind of chart it is.
    %%field ChartDefinition.chart_type help: bar, line, area, pie, scatter or table. It is a claim about the data's shape: a line implies a continuous series, and using one for unordered categories misleads a reader who is reading the shape rather than the labels.
    %%field ChartDefinition.x_field help: The query column plotted along the horizontal axis — normally the dimension being compared or the period being tracked. It must be a column the query actually returns.
    %%field ChartDefinition.y_field help: The query column plotted vertically — the measure being read off. A chart with a measure on the wrong axis is not wrong so much as unreadable.
    %%field ChartDefinition.refresh_interval_seconds help: How often an open chart re-runs its query. Short intervals on a heavy query are the most common way a dashboard puts load on a production database.
    %%field ChartDefinition.is_public help: Whether the whole workspace may see the chart, or only its owner. A chart on a public dashboard has to be public itself, or the dashboard renders a gap.

    %%entity Dashboard help: A page of reports and charts arranged together to answer one recurring question — how did last week go, where are we against target. Dashboards are what most people in a business actually use the platform for, and they are the reason reports and charts are definitions rather than one-off runs.
    %%field Dashboard.workspace_id help: The workspace this dashboard belongs to. Every widget on it must draw on the same workspace's queries, which is what keeps the tenancy boundary intact.
    %%field Dashboard.owner_id help: The analyst who maintains it. Dashboards decay quietly as underlying queries change, and this is who is expected to notice.
    %%field Dashboard.name help: The dashboard's title, and the thing people will refer to it by in conversation. Name it for the question it answers.
    %%field Dashboard.description help: What this page is for, who it is for, and how often the numbers on it move. It is what stops three near-identical dashboards being built by three different people.
    %%field Dashboard.is_public help: Whether everybody in the workspace can open it. A dashboard is usually meant to be shared — an unshared one is a working page, and saying which it is prevents the awkward discovery that nobody else could see it.
    %%field Dashboard.column_count help: How many columns the grid is divided into. Widget positions below are expressed in this grid, so changing it reflows the whole page.

    %%entity DashboardWidget parent: Dashboard
    %%entity DashboardWidget help: One panel on one dashboard: which report or chart it shows, and where it sits on the grid. It is a line item of the dashboard — a widget away from its page has no position and no meaning — and it holds either a report or a chart, never both.
    %%field DashboardWidget.dashboard_id help: The page this panel sits on. Read inside the dashboard, where the widgets together are the layout.
    %%field DashboardWidget.report_definition_id help: The report shown in this panel, when the panel is tabular. Empty when the widget shows a chart instead — exactly one of the two references is set.
    %%field DashboardWidget.chart_definition_id help: The chart drawn in this panel. Empty when the widget shows a report, for the same reason.
    %%field DashboardWidget.title help: The heading over this panel, which may differ from the report's or chart's own name — a dashboard often needs a shorter or more pointed label than the definition carries.
    %%field DashboardWidget.grid_x help: The panel's column position on the dashboard's grid, counted from the left. With the width it decides whether two panels sit side by side or collide.
    %%field DashboardWidget.grid_y help: The panel's row position, counted from the top. It is what fixes reading order, and reading order is most of what makes a dashboard legible.
    %%field DashboardWidget.grid_width help: How many grid columns the panel spans. A chart squeezed into two columns of a twelve-column grid is technically present and practically unreadable.
    %%field DashboardWidget.grid_height help: How many rows the panel spans. Tables need more than charts, which is the usual reason a dashboard has to be re-laid-out after a widget is swapped.

    %%field ScheduledJob.report_id help: The report to run and deliver. Only reports are scheduled, not charts: what arrives by email is a document, and a chart's value is in being looked at rather than filed.
    %%field ScheduledJob.requested_by_id help: The analyst who set the schedule up. It is who is asked to justify a delivery that is still running long after anybody needed it.
    %%field ScheduledJob.name help: What this schedule is called internally, so a list of dozens of them can be maintained. Name it for the audience and the cadence — `Regional sales, Monday 8am`.
    %%field ScheduledJob.schedule_cron help: When to run, as a cron expression in the platform's own time zone. The time zone is the thing that catches people out: a delivery set for 08:00 arrives at a different local hour for half its recipients.
    %%field ScheduledJob.export_format help: csv, xlsx or pdf. It is a decision about what the recipient will do with it — a spreadsheet for somebody who will re-cut the numbers, a PDF for somebody who will read and forward it.
    %%field ScheduledJob.recipients help: Who receives the delivery. Recipients do not need platform accounts, which is what makes a schedule useful and also what makes an unreviewed recipient list a data-disclosure risk.
    %%field ScheduledJob.is_active help: Whether the schedule still runs. Pausing is the right way to stop a delivery: deleting it loses the execution history that says what was sent to whom.

    %%entity JobExecution parent: ScheduledJob
    %%entity JobExecution help: One run of one scheduled job, successful or not. Executions are kept for every run rather than only for failures, because the question a recipient asks is usually 'did this go out on the 1st' and the only honest answer comes from a record of the run.
    %%field JobExecution.scheduled_job_id help: The schedule this run belongs to. Read inside the job, where the executions together are its delivery history.
    %%field JobExecution.status help: scheduled, queued, running, succeeded, failed or cancelled. Only the moves the lifecycle draws are allowed, so a run cannot be recorded as succeeded without having run.
    %%field JobExecution.started_at help: When the run actually began, as opposed to when it was due. A widening gap between the two is the first sign the job queue is behind.
    %%field JobExecution.finished_at help: When it ended. With the start time it gives the duration, which is what says whether a query has outgrown its schedule.
    %%field JobExecution.row_count help: How many rows were delivered. It is the cheapest correctness check there is: a report that normally sends four thousand rows and today sent none has not failed, and needs looking at.
    %%field JobExecution.error_message help: What went wrong, kept verbatim from the failure. It is what distinguishes an unreachable data source from a broken query, and the two need entirely different people to fix them.

    %%index DataSource(workspace_id, name) unique
    %%index SavedQuery(data_source_id)
    %%index SchemaEntity(data_source_id, table_name) unique
    %%index JobExecution(scheduled_job_id, started_at)

%% ---- The questions this workspace's own users ask -------------------------
%%
%% Derived reports cover the shape of the data: a register per entity, a
%% breakdown per enum, a lifecycle per state machine. These are the ones that
%% need somebody who knows the job. An analytics team lead does not open the
%% tool asking "how many saved queries are there"; they ask which sources are
%% unreachable, which scheduled deliveries are failing, and which expensive
%% queries nobody has run in months.
    %%report unreachable-sources title: Data sources that are not answering entity: DataSource chart: bar x: source y: days_since_check help: The first thing to check when a report comes back empty. A source stuck in testing or unreachable is a reporting outage nobody has noticed yet. sql: SELECT name AS source, COALESCE(EXTRACT(day FROM now() - last_checked_at), 0)::int AS days_since_check FROM bus_data_source WHERE status IN ('unreachable', 'testing') AND deleted_at IS NULL ORDER BY days_since_check DESC
    %%report failing-deliveries title: Scheduled deliveries that failed entity: JobExecution help: Every failed run of a standing report, newest first, with the error. A delivery that fails silently is a report somebody is waiting on and will not chase. sql: SELECT j.name AS job, e.started_at, e.error_message FROM bus_job_execution e JOIN bus_scheduled_job j ON j.id = e.scheduled_job_id WHERE e.status = 'failed' AND e.deleted_at IS NULL ORDER BY e.started_at DESC LIMIT 100
    %%report stale-queries title: Saved queries nobody runs entity: SavedQuery chart: bar x: query y: days_idle help: Published queries with no run in ninety days. Each one is a maintenance cost and a wrong answer waiting to be quoted. sql: SELECT name AS query, COALESCE(EXTRACT(day FROM now() - last_run_at), 999)::int AS days_idle FROM bus_saved_query WHERE status = 'published' AND (last_run_at IS NULL OR last_run_at < now() - interval '90 days') AND deleted_at IS NULL ORDER BY days_idle DESC LIMIT 50
    %%report dashboard-coverage title: Dashboards by widget count entity: Dashboard chart: bar x: dashboard y: widgets help: A dashboard with one widget is usually an abandoned draft; one with twenty is usually unreadable. sql: SELECT d.name AS dashboard, COUNT(w.id) AS widgets FROM bus_dashboard d LEFT JOIN bus_dashboard_widget w ON w.dashboard_id = d.id AND w.deleted_at IS NULL WHERE d.deleted_at IS NULL GROUP BY 1 ORDER BY widgets DESC

%% ---- Section 2: Business rules --------------------------------------------
%%meta name: Query Safety
%%meta kind: rules
%%rule querySafety on SavedQuery event: beforeCreate priority: 10
flowchart TD
    A([Start: Query Submitted]) --> B{Row limit set?}
    B -->|No| R1[Reject: Unbounded Query]
    B -->|Yes| C{Source is readonly?}
    C -->|No| R2[Warn: Writable Source]
    C -->|Yes| P(Accept Query)
    R1 --> E([End])
    R2 --> E
    P  --> E

    %%action requireRowLimit validation-error when: row_limit == null message: A saved query must declare a row limit — an unbounded query runs against a production database
    %%action capRowLimit transform when: row_limit > 100000 field: row_limit value: 100000 message: Row limit capped at 100000

%%meta name: Publication Gate
%%meta kind: rules
%%rule publicationGate on ReportDefinition event: beforeUpdate priority: 20
flowchart TD
    A([Start: Publish Requested]) --> B{Query published?}
    B -->|No| R1[Reject: Draft Query]
    B -->|Yes| P(Allow Publication)
    R1 --> E([End])
    P  --> E

    %%action limitPublicPageSize validation-error when: is_public == true and page_size > 1000 message: A public report may not page more than 1000 rows at a time

%% ---- Section 3: Workflow — the delivery lifecycle -------------------------
%%meta name: Delivery Lifecycle
%%meta kind: workflow
%%workflow DeliveryLifecycle entity: JobExecution kind: state
stateDiagram-v2
    [*] --> scheduled
    scheduled --> queued   : enqueue
    queued --> running     : start
    running --> succeeded  : complete
    running --> failed     : error
    scheduled --> cancelled : cancel
    queued --> cancelled    : cancel
    failed --> queued       : retry
    succeeded --> [*]
    cancelled --> [*]

%% ---- Section 4: Workflow — lifecycle hooks --------------------------------
%%meta name: Source Onboarding
%%meta kind: workflow
%%workflow SourceOnboarding entity: DataSource kind: hook
flowchart TD
    A[Client Request] --> B[Validate Request]
    B --> C[beforeCreate: encryptConnectionConfig]
    C --> D[Process DataSource]
    D --> E[afterCreate: introspectSchema]
    E --> F[afterUpdate: refreshSchemaEmbeddings]
    F --> G[Response]

    %%hook beforeCreate encryptConnectionConfig on DataSource
    %%hook afterCreate introspectSchema on DataSource
    %%hook afterUpdate refreshSchemaEmbeddings on DataSource

