%%rbac role:analyst on SavedQuery.create
%%rbac role:analyst|viewer on ReportDefinition.read
%%rbac role:analyst|viewer on ChartDefinition.read
%%rbac role:analyst|viewer on Dashboard.read
%%rbac role:analyst|viewer on DashboardWidget.read
%%rbac role:analyst|viewer on JobExecution.read
%%rbac role:analyst on ScheduledJob.read
%%rbac role:admin on ScheduledJob.delete
%%rbac role:admin|analyst on SchemaEntity.read
%%rbac role:admin on Workspace.read
%%rbac role:admin on Analyst.read
