# ==========================================
# Llama.cpp Server - Text-to-SQL Engine
# Optional service for NL Query support
# ==========================================
FROM node:20-alpine

WORKDIR /app

# Install dependencies
RUN apk add --no-cache curl ca-certificates

# For now, use a placeholder that logs the availability
# In production, you can replace this with actual llama.cpp server
# Or use the official llama.cpp Docker image:
# docker run -p 8080:8080 ghcr.io/ggml-org/llama.cpp:latest -m model.gguf

RUN echo '#!/bin/sh' > /app/start.sh && \
    echo 'echo "Llama.cpp NL Query server"' >> /app/start.sh && \
    echo 'echo "To enable: Use official llama.cpp Docker image or compile locally"' >> /app/start.sh && \
    echo 'echo "Keeping container alive..."' >> /app/start.sh && \
    echo 'exec tail -f /dev/null' >> /app/start.sh && \
    chmod +x /app/start.sh

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=2 \
    CMD curl -f http://localhost:8080/health || exit 1

CMD ["/app/start.sh"]

# Create models directory
RUN mkdir -p /app/models

# Download SLM-SQL-Base-0.6B GGUF model (quantized for efficiency)
# Using 3-bit quantization for smallest footprint
RUN curl -L -o /app/models/slm-sql-base-0.6b.Q3_K_M.gguf \
    "https://huggingface.co/mradermacher/SLM-SQL-Base-0.6B-GGUF/resolve/main/SLM-SQL-Base-0.6B.Q3_K_M.gguf" || \
    echo "Model download failed - will need to be mounted or downloaded manually"

# Expose llama.cpp server port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Start llama.cpp server optimized for Text-to-SQL
CMD ["/app/llama-server", \
     "-m", "/app/models/slm-sql-base-0.6b.Q3_K_M.gguf", \
     "--host", "0.0.0.0", \
     "--port", "8080", \
     "-c", "512", \
     "-n", "256", \
     "--gpu-layers", "35", \
     "--batch-size", "128"]
