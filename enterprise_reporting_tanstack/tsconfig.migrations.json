{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "outDir": "dist/migrations",
    "rootDir": "src/lib/db/migrations",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "types": ["bun-types"]
  },
  "include": ["src/lib/db/migrations/**/*"],
  "exclude": ["node_modules"]
}
