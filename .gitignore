# Root-level only. Each product keeps its own .gitignore; this covers what runs
# the two together.

node_modules/

# Everything ./start.sh writes: the generated application, the reporting pack
# derived from the model, and the secrets it generates on first run. All of it
# is reproducible from a model plus ./start.sh, and none of it belongs in git —
# least of all common/.runtime/.env.
common/.runtime/

# The checker writes a `.error` file beside every model it reads — that is its
# interface, not an accident. `examples/hospital-management-system.mmd.error` is
# checked in on purpose and does not match: it is a `.mmd.error`, not an
# `.eml.mmd.error`.
*.eml.mmd.error

# The two products, fetched from their own repositories by
# common/build/fetch-repos.sh and symlinked here.
#
# They are symlinks into common/.runtime/repos/, and the symlink is what makes
# the clone usable: both projects contain relative paths that reach across the
# folder boundary — the root CLI imports two modules out of
# app-with-ai-tanstack/packages and loads its generator orchestrator at runtime
# — so a clone parked anywhere else would need every one of those rewritten.
# Ignored rather than committed: a symlink in git is a path, and this one points
# at a directory that exists only after ./start.sh has run.
/app-with-ai-tanstack
/enterprise_reporting_tanstack
