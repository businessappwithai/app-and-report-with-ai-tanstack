{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "modules/rules/jdm/*.json",
        "outDir": "dist/src"
      },
      {
        "include": "common/logging/log-spec.json",
        "outDir": "dist/src"
      }
    ],
    "watchAssets": true
  }
}
